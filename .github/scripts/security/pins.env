# Adopted Q-06 tool pins (official release digests, linux x86_64) and the
# RustSec dataset floor. Changing any value is a reviewed source change.
CARGO_AUDIT_VERSION=0.22.2
CARGO_AUDIT_URL=https://github.com/rustsec/rustsec/releases/download/cargo-audit/v0.22.2/cargo-audit-x86_64-unknown-linux-musl-v0.22.2.tgz
CARGO_AUDIT_SHA256=7fb9497f8594b389e5fce5ef9b92db08432996895b2e0c5a0167a69ed445c428
GITLEAKS_VERSION=8.30.1
GITLEAKS_URL=https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_URL=https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
# Dataset origin. The snapshot captured at run time must come from this
# origin and descend from the last Q-06-verified commit (no rollback).
ADVISORY_DB_URL=https://github.com/RustSec/advisory-db.git
ADVISORY_DB_FLOOR=309392b18f6b17022f82c701f300433126901068
# Adopted Q-06 execution window (Q06_DATASET_PIN_DISPOSITION_2026-10-02): the
# snapshot is observed once at acquisition and is eligible for scans that
# start and finish within this many seconds of that observation. It is never
# extended, renewed or substituted inside a run. This is NOT a dataset-age
# policy: the commit's age is not tested. A dataset-age rule would need an
# explicit disposition and is not adopted here.
ADVISORY_DB_WINDOW_SECONDS=86400
