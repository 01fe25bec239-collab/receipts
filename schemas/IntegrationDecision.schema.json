{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://receipts.invalid/orchestrator/schemas/IntegrationDecision.schema.json",
  "title": "Integration Decision \u2014 the strongest gate; reconstructible from persisted provenance",
  "schema_version": "0.1.0-draft",
  "x-owner": "BUILD-A2-REVIEW-INTEGRATION",
  "x-status": "ARCHITECTURE_CANDIDATE_NOT_FROZEN",
  "type": "object",
  "required": [
    "decision_id",
    "request_id",
    "outcome",
    "checks_evaluated",
    "decided_at"
  ],
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "decision"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "request"
    },
    "outcome": {
      "enum": [
        "ACCEPT",
        "REPAIR",
        "BLOCKED",
        "HUMAN_REQUIRED"
      ]
    },
    "checks_evaluated": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "provenance_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "start_sha",
          "implementation_sha",
          "review_sha"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "task"
          },
          "start_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "implementation_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "review_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "acceptance_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "integration_sha": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "unmet_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integration_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
