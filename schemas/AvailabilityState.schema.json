{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://receipts.invalid/orchestrator/schemas/AvailabilityState.schema.json",
  "title": "Availability State \u2014 normalized provider/model availability",
  "schema_version": "0.1.0-draft",
  "x-owner": "BUILD-A2-MODEL-ROUTING",
  "x-status": "ARCHITECTURE_CANDIDATE_NOT_FROZEN",
  "type": "object",
  "required": [
    "provider_id",
    "state",
    "observed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque provider identifier. MUST NOT be constrained to an enum; new providers must validate without a schema change."
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque model identifier. MUST NOT be constrained to an enum."
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque agent-runtime identifier. MUST NOT be constrained to an enum."
    },
    "state": {
      "enum": [
        "AVAILABLE",
        "DEGRADED",
        "RATE_LIMITED",
        "SESSION_EXHAUSTED",
        "AUTH_REQUIRED",
        "PROVIDER_DOWN",
        "SAFETY_CHECK_PENDING",
        "POLICY_BLOCKED",
        "UNKNOWN"
      ]
    },
    "retry_after_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "signal_source": {
      "enum": [
        "RATE_LIMIT_HEADER",
        "EXIT_CODE",
        "STDERR_CLASSIFICATION",
        "LOCAL_USAGE_VIEW",
        "LATENCY_TREND",
        "PROBE",
        "UNKNOWN"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  }
}
