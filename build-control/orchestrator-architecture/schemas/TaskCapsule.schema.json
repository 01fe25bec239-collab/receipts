{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://receipts.invalid/orchestrator/schemas/TaskCapsule.schema.json",
  "title": "Task Capsule \u2014 complete context for one ephemeral RUNTIME-A3 attempt",
  "schema_version": "0.1.0-draft",
  "x-owner": "BUILD-A2-ORCHESTRATION",
  "x-status": "ARCHITECTURE_CANDIDATE_NOT_FROZEN",
  "type": "object",
  "required": [
    "task_id",
    "workstream_id",
    "attempt_number",
    "task_type",
    "objective",
    "acceptance_criteria",
    "baseline_sha",
    "start_sha",
    "allowed_write_paths",
    "forbidden_write_paths",
    "quality_floor",
    "required_capabilities",
    "verification_plan",
    "assurance_profile",
    "branch",
    "worktree",
    "stop_conditions",
    "context_epoch"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "immutable task id"
    },
    "workstream_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "owning workstream"
    },
    "parent_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "parent for repair attempts"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "task_type": {
      "enum": [
        "IMPLEMENTATION",
        "REPAIR",
        "TEST",
        "REFACTOR",
        "MIGRATION",
        "DOCS",
        "INVESTIGATION",
        "SECURITY_FIX"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "criterion id"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "DETERMINISTIC",
              "SEMANTIC"
            ]
          },
          "check_command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "start_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "allowed_write_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_write_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relevant_context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_type",
          "target"
        ],
        "properties": {
          "ref_type": {
            "enum": [
              "REPO_PATH",
              "STATE_QUERY",
              "ARTIFACT_ID",
              "URL"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "architecture_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_type",
          "target"
        ],
        "properties": {
          "ref_type": {
            "enum": [
              "REPO_PATH",
              "STATE_QUERY",
              "ARTIFACT_ID",
              "URL"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "contract_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_type",
          "target"
        ],
        "properties": {
          "ref_type": {
            "enum": [
              "REPO_PATH",
              "STATE_QUERY",
              "ARTIFACT_ID",
              "URL"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "task id"
      }
    },
    "quality_floor": {
      "enum": [
        "FRONTIER",
        "BALANCED",
        "ECONOMY"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "preferred_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "command",
          "exit_code",
          "code_sha"
        ],
        "properties": {
          "source": {
            "enum": [
              "WORKER_EXECUTION",
              "BROKER_EXECUTION",
              "REVIEW_EXECUTION",
              "GIT_PROVENANCE"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Explicit argv. Never a shell string."
          },
          "exit_code": {
            "type": "integer"
          },
          "code_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "timed_out": {
            "type": "boolean"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "output_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_type",
              "target"
            ],
            "properties": {
              "ref_type": {
                "enum": [
                  "REPO_PATH",
                  "STATE_QUERY",
                  "ARTIFACT_ID",
                  "URL"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string"
              },
              "section": {
                "type": "string"
              }
            }
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "SKIPPED",
              "UNKNOWN"
            ]
          }
        }
      },
      "minItems": 1
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "distinct_provider": {
          "enum": [
            "OFF",
            "PREFERRED",
            "REQUIRED"
          ]
        },
        "reviewer_floor": {
          "enum": [
            "FRONTIER",
            "BALANCED",
            "ECONOMY"
          ]
        }
      }
    },
    "assurance_profile": {
      "enum": [
        "LIGHT",
        "STANDARD",
        "HIGH_ASSURANCE"
      ]
    },
    "cost_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost": {
          "type": [
            "number",
            "null"
          ]
        },
        "priority": {
          "enum": [
            "HIGHEST",
            "HIGH",
            "SECONDARY",
            "LOW"
          ]
        }
      }
    },
    "time_budget_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "turn_budget": {
      "type": "integer",
      "minimum": 1
    },
    "branch": {
      "type": "string",
      "pattern": "^runtime-a3/"
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "remote_publish_policy": {
      "enum": [
        "LOCAL_ONLY",
        "PUSH_ON_ACCEPT",
        "PUSH_ALWAYS"
      ]
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "handoff_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "target"
      ],
      "properties": {
        "ref_type": {
          "enum": [
            "REPO_PATH",
            "STATE_QUERY",
            "ARTIFACT_ID",
            "URL"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "context_epoch": {
      "type": "integer",
      "minimum": 0
    }
  }
}
